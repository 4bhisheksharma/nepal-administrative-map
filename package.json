{
  "name": "nepal-administrative-map",
  "version": "0.0.1",
  "description": "Interactive, bilingual (English/Nepali) map of Nepal's 7 provinces, 77 districts and 753 local levels, with zoom, drill-down, choropleths and search.",
  "license": "MIT",
  "author": "Abhishek Sharma",
  "homepage": "https://github.com/4bhisheksharma/nepal_administrative_map",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/4bhisheksharma/nepal_administrative_map.git",
    "directory": "nepal-administrative-map"
  },
  "bugs": {
    "url": "https://github.com/4bhisheksharma/nepal_administrative_map/issues"
  },
  "keywords": [
    "map",
    "nepal",
    "geography",
    "i18n",
    "visualization",
    "react",
    "choropleth",
    "topojson",
    "canvas"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./core": {
      "import": {
        "types": "./dist/core.d.ts",
        "default": "./dist/core.js"
      },
      "require": {
        "types": "./dist/core.d.cts",
        "default": "./dist/core.cjs"
      }
    },
    "./assets/maps/nepal.topo.json": "./assets/maps/nepal.topo.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*.js",
    "dist/**/*.cjs",
    "dist/**/*.d.ts",
    "dist/**/*.d.cts",
    "assets/maps/nepal.topo.json",
    "assets/screenshots",
    "LICENSE",
    "DATA_LICENSE.md",
    "README.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "sync-assets": "node scripts/sync-assets.mjs",
    "generate": "node scripts/generate-gazetteer.mjs",
    "prebuild": "npm run sync-assets && npm run generate",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "npm run typecheck && npm run build",
    "dev:example": "npm --prefix example run dev"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.4.0",
    "typescript": "^5.8.0"
  }
}
